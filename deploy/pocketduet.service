# Servicio systemd para PocketDuet en un VPS (deploy/README.md, opción C).
# Copiar a /etc/systemd/system/pocketduet.service, ajustar rutas/usuario/clave y:
#   sudo systemctl daemon-reload && sudo systemctl enable --now pocketduet
[Unit]
Description=PocketDuet - hub de emulacion retro en el navegador
After=network.target

[Service]
Type=simple
User=pocketduet
WorkingDirectory=/srv/pocketduet
Environment=HOST=127.0.0.1
Environment=PORT=8080
Environment=ACCESS_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=3
# melonDS-WASM usa hilos y memoria compartida: deja limites holgados
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
