# Alternativa a Caddy con Nginx (deploy/README.md, opción C).
# OJO: no quites las cabeceras COOP/COEP; si el upstream las manda, se reenvían tal cual.
server {
    listen 443 ssl http2;
    server_name pocketduet.tudominio.com;

    ssl_certificate     /etc/letsencrypt/live/pocketduet.tudominio.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pocketduet.tudominio.com/privkey.pem;

    # ROMs grandes y guardados: sin límite de cuerpo para el PUT del .sav
    client_max_body_size 32m;
    proxy_read_timeout   600s;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # WebSocket de socket.io
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
